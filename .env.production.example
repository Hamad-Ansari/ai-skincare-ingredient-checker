# Copy to .env.production on the Linux host; chmod 600 .env.production.
# All *_PASSWORD values below should be hexadecimal secrets so the PostgreSQL
# connection URL cannot be broken by reserved URL characters.
SITE_ADDRESS=
APP_IMAGE_TAG=local
APP_SECRET_KEY=

# PostgreSQL bootstrap superuser. Never use this account from the API.
POSTGRES_DB=clarity_checker
POSTGRES_ADMIN_USER=clarity_admin
POSTGRES_ADMIN_PASSWORD=

# Restricted runtime/migration role, owner of this one application database.
APP_DB_USER=clarity_app
APP_DB_PASSWORD=

# Production requires a working SMTP relay using STARTTLS on port 587.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
