# Example placeholders only. Do not put real credentials in this file.
APP_ENV=development
APP_SECRET_KEY=
DATABASE_URL=sqlite:///./data/clarity_checker.db
LOG_LEVEL=INFO

# Authentication/session controls. Development token exposure is only for local testing.
SESSION_COOKIE_NAME=clarity_session
CSRF_COOKIE_NAME=clarity_csrf
SESSION_TTL_HOURS=12
VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
AUTH_EXPOSE_DEV_TOKENS=true
AI_CONSENT_DISCLOSURE_VERSION=clarity-cloud-consent-v2

# Local frontend/API origin. Add explicit origins only if the frontend is hosted separately.
ALLOWED_ORIGINS=http://localhost:8000

# Local RAG embeddings. Install/pull the configured Ollama model before indexing evidence.
# Ollama chat is optional; no model call occurs unless an explanation is explicitly requested.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBED_MODEL=embeddinggemma

# Optional on-demand explanations. OpenAI/Groq require current provider-specific account consent.
# Keys stay server-side; requests contain one confirmed ingredient, one reviewed finding,
# and currently approved evidence summaries/only excerpts permitted for reproduction.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
GROQ_API_KEY=
GROQ_CHAT_MODEL=
LLM_TIMEOUT_SECONDS=30

# Qdrant: configure either QDRANT_URL (remote/server) OR VECTOR_DB_PATH (single-process local).
# For QDRANT_URL, set VECTOR_DB_PATH= and provide a secret QDRANT_API_KEY only if required.
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
VECTOR_DB_PATH=./data/qdrant
QDRANT_COLLECTION=clarity_evidence_v1
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_TOP_K=5

# Private local scan-photo storage and bounded image/OCR intake.
PRIVATE_SCAN_STORAGE_DIR=./data/private/scans
SCAN_MAX_UPLOAD_BYTES=10485760
SCAN_MAX_IMAGE_PIXELS=20000000
OCR_TESSERACT_COMMAND=tesseract
OCR_TESSERACT_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=30

# Optional SMTP delivery; local development can use dev tokens above instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true

# OpenAI/Groq account-level consent is stored in the database, not environment variables.
